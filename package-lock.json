{
  "name": "sddbuilder",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sddbuilder",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "5.9.3"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@sddbuilder/api",
      "version": "0.0.0",
      "dependencies": {
        "@sddbuilder/core": "*"
      }
    },
    "apps/web": {
      "name": "@sddbuilder/web",
      "version": "0.0.0",
      "dependencies": {
        "@sddbuilder/core": "*"
      }
    },
    "node_modules/@sddbuilder/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@sddbuilder/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@sddbuilder/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core": {
      "name": "@sddbuilder/core",
      "version": "0.0.0"
    }
  }
}
