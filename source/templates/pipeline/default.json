{
  "schemaVersion": 2,
  "name": "Default SDD process",
  "idea": "The default pipeline: one feature at a time through specify, ux, plan, build, verify and complete, with a human approval at each design step and a human checklist before completion.",
  "stack": {
    "language": "unspecified"
  },
  "pipeline": {
    "name": "default",
    "blocks": [
      {
        "kind": "start",
        "id": "pipeline-start",
        "enabled": true,
        "arguments": [
          {
            "name": "feature-id",
            "required": true,
            "hint": "The feature to run, e.g. F-01"
          }
        ]
      },
      {
        "kind": "flow",
        "id": "specify",
        "name": "Specify",
        "description": "Turns the feature into user stories with testable acceptance criteria, then waits for approval.",
        "enabled": true,
        "blocks": [
          { "kind": "start", "id": "specify-start", "enabled": true },
          { "kind": "agent", "id": "specify-agent", "enabled": true, "name": "specify", "scope": "feature", "description": "Drafts stories.md for the feature, after the main session asks its questions." },
          { "kind": "end", "id": "specify-end", "enabled": true, "outcome": "done", "produced": "stories.md" }
        ]
      },
      {
        "kind": "connection",
        "id": "specify-to-ux",
        "enabled": true,
        "from": "specify",
        "to": "ux",
        "artifact": "stories.md"
      },
      {
        "kind": "condition",
        "id": "approve-stories",
        "enabled": true,
        "description": "the user approves the stories as written.",
        "checkType": "approval",
        "decidedBy": "human",
        "passRoute": { "kind": "next" },
        "failRoute": { "kind": "back", "blockId": "specify" },
        "onConnection": "specify-to-ux"
      },
      {
        "kind": "flow",
        "id": "ux",
        "name": "UX",
        "description": "Draws the feature's screens as SVG from the stories, then waits for approval before the plan.",
        "enabled": true,
        "blocks": [
          { "kind": "start", "id": "ux-start", "enabled": true },
          { "kind": "agent", "id": "ux-agent", "enabled": true, "name": "ux", "scope": "feature", "description": "Draws the feature's screens under spec/design/features/ from the stories." },
          { "kind": "end", "id": "ux-end", "enabled": true, "outcome": "done", "produced": "design/features/" }
        ]
      },
      {
        "kind": "connection",
        "id": "ux-to-plan",
        "enabled": true,
        "from": "ux",
        "to": "plan",
        "artifact": "design/features/"
      },
      {
        "kind": "condition",
        "id": "approve-screens",
        "enabled": true,
        "description": "the user approves the screens as written.",
        "checkType": "approval",
        "decidedBy": "human",
        "passRoute": { "kind": "next" },
        "failRoute": { "kind": "back", "blockId": "ux" },
        "onConnection": "ux-to-plan"
      },
      {
        "kind": "flow",
        "id": "plan",
        "name": "Plan",
        "description": "Writes the ordered task list from the stories and the approved screens, then waits for approval before any code.",
        "enabled": true,
        "blocks": [
          { "kind": "start", "id": "plan-start", "enabled": true },
          { "kind": "agent", "id": "plan-agent", "enabled": true, "name": "plan", "scope": "feature", "description": "Drafts plan.md from the stories and the approved screens." },
          { "kind": "end", "id": "plan-end", "enabled": true, "outcome": "done", "produced": "plan.md" }
        ]
      },
      {
        "kind": "connection",
        "id": "plan-to-build",
        "enabled": true,
        "from": "plan",
        "to": "build",
        "artifact": "plan.md"
      },
      {
        "kind": "condition",
        "id": "approve-plan",
        "enabled": true,
        "description": "the user approves the plan before any code is written.",
        "checkType": "approval",
        "decidedBy": "human",
        "passRoute": { "kind": "next" },
        "failRoute": { "kind": "back", "blockId": "plan" },
        "onConnection": "plan-to-build"
      },
      {
        "kind": "flow",
        "id": "build",
        "name": "Build",
        "description": "Implements each planned task with its tests, reviews it, runs the checks and commits it, one commit per task.",
        "enabled": true,
        "blocks": [
          { "kind": "start", "id": "build-start", "enabled": true },
          { "kind": "agent", "id": "build-implement", "enabled": true, "name": "implement", "scope": "task", "description": "Implements the next unchecked task of plan.md, with its tests." },
          { "kind": "agent", "id": "build-review", "enabled": true, "name": "review", "scope": "task", "description": "Reviews the task's changes and reports blockers or a clean result." },
          {
            "kind": "condition",
            "id": "build-review-gate",
            "enabled": true,
            "description": "the review reports no blocker or warning",
            "checkType": "checks",
            "decidedBy": "agent",
            "passRoute": { "kind": "next" },
            "failRoute": { "kind": "back", "blockId": "build-implement" }
          },
          { "kind": "agent", "id": "build-test", "enabled": true, "name": "test", "scope": "task", "description": "Runs the task's tests and checks the acceptance criteria it covers." },
          {
            "kind": "condition",
            "id": "build-checks",
            "enabled": true,
            "description": "the type check and the test suite pass",
            "checkType": "checks",
            "decidedBy": "agent",
            "passRoute": { "kind": "next" },
            "failRoute": { "kind": "back", "blockId": "build-implement" }
          },
          {
            "kind": "condition",
            "id": "build-diff-size",
            "enabled": true,
            "description": "the task changes at most the threshold number of lines",
            "checkType": "diff-size",
            "threshold": 400,
            "decidedBy": "agent",
            "passRoute": { "kind": "next" },
            "failRoute": { "kind": "stop" }
          },
          { "kind": "agent", "id": "build-commit", "enabled": true, "name": "commit", "scope": "task", "description": "Commits the finished task on its own, with the feature ID in the message." },
          { "kind": "end", "id": "build-end", "enabled": true, "outcome": "done" }
        ]
      },
      {
        "kind": "connection",
        "id": "build-to-verify",
        "enabled": true,
        "from": "build",
        "to": "verify",
        "artifact": "committed tasks"
      },
      {
        "kind": "condition",
        "id": "checks-built",
        "enabled": true,
        "description": "every built task passes the checks",
        "checkType": "checks",
        "decidedBy": "agent",
        "passRoute": { "kind": "next" },
        "failRoute": { "kind": "stop" },
        "onConnection": "build-to-verify"
      },
      {
        "kind": "flow",
        "id": "verify",
        "name": "Verify",
        "description": "Checks every acceptance criterion of the feature and prepares the manual checklist.",
        "enabled": true,
        "blocks": [
          { "kind": "start", "id": "verify-start", "enabled": true },
          { "kind": "agent", "id": "verify-agent", "enabled": true, "name": "verify", "scope": "feature", "description": "Verifies in verify mode that every criterion of the feature is covered." },
          { "kind": "end", "id": "verify-end", "enabled": true, "outcome": "done", "produced": "verification report" }
        ]
      },
      {
        "kind": "connection",
        "id": "verify-to-complete",
        "enabled": true,
        "from": "verify",
        "to": "complete",
        "artifact": "verification report"
      },
      {
        "kind": "condition",
        "id": "approve-checklist",
        "enabled": true,
        "description": "the user approves the verification and the manual checklist.",
        "checkType": "approval",
        "decidedBy": "human",
        "passRoute": { "kind": "next" },
        "failRoute": { "kind": "back", "blockId": "verify" },
        "onConnection": "verify-to-complete"
      },
      {
        "kind": "flow",
        "id": "complete",
        "name": "Complete",
        "description": "Marks the feature complete and commits its spec folder.",
        "enabled": true,
        "blocks": [
          { "kind": "start", "id": "complete-start", "enabled": true },
          { "kind": "agent", "id": "complete-agent", "enabled": true, "name": "complete", "scope": "feature", "description": "Marks the feature complete and commits its spec folder." },
          { "kind": "end", "id": "complete-end", "enabled": true, "outcome": "done", "produced": "completed feature" }
        ]
      },
      { "kind": "end", "id": "pipeline-end", "enabled": true, "outcome": "done" }
    ]
  },
  "rules": []
}
